# .gitignore for Absolute Fitness project

# Node.js dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/
*.lcov

# Build outputs
.next/
out/
dist/
build/

# dotenv environment variables
.env*
!.env.example

# TypeScript cache
*.tsbuildinfo

# Docker files
docker-compose*.yml
.docker/
docker/data/

# Database data directories
pgdata/
postgres-data/
data/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-specific files
.DS_Store
Thumbs.db
node_modules
